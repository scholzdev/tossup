<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs the game's UI code (everything under Assets/Scripts except the Unity host and GL backend) headless. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="LatestTests.cs" />
    <Compile Include="AuditRegressionTests.cs" />
    <Compile Include="FeatureParityTests.cs" />
    <Compile Include="../../Assets/Scripts/Core/**/*.cs" />
    <Compile Include="../../Assets/Scripts/Content/**/*.cs" />
    <Compile Include="../../Assets/Scripts/UI/**/*.cs" />
    <Compile Include="../../Assets/Scripts/Render/Gfx.cs" />
  </ItemGroup>
</Project>
